{
  "schemaVersion": 1,
  "id": "cinchsmissingblocks",
  "version": "${version}",
  "name": "Cinch's Missing Blocks",
  "description": "This mod adds all the blocks missing from minecraft.",
  "authors": [
    "Cinchtail"
  ],
  "contributors": [
    "Texture Artists:",
    "- Stallman",
    "- Popopi",
    "- Myheadmess\n",
    "Translators:",
    "- kierohere",
    "- Piotrus983"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/cinchs-missing-blocks",
    "sources": "https://github.com/cinchtail/Cinchs_Missing_Blocks"
  },
  "license": "ARR",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.cinchtail.cinchsmissingblocks.CinchsMissingBlocks"
    ],
    "client": [
      "net.cinchtail.cinchsmissingblocks.CinchsMissingBlocksClient"
    ],
    "fabric-datagen": [
      "net.cinchtail.cinchsmissingblocks.datagen.DataGenerators"
    ]
  },
  "mixins": [
    "cinchsmissingblocks.mixins.json",
    "cinchsmissingblocks.fabric.mixins.json"
  ],
  "custom": {
    "fabric-networking-api-v1": true
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
